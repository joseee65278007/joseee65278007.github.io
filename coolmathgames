    <title>games</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: #0b0c10;
            /* Retro space-dust confetti pattern background matching your image */
            background-image: 
                radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px),
                radial-gradient(circle, rgba(255,255,255,0.1) 2px, transparent 2px);
            background-size: 40px 40px, 60px 60px;
            color: #ffffff;
            min-height: 100vh;
            padding: 50px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-y: auto;
        }

        .header-container {
            text-align: center;
            margin-bottom: 35px;
            width: 100%;
            max-width: 500px;
        }

        h1 {
            font-size: 56px;
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 20px;
            color: #ffffff;
        }

        /* Centered Rounded Search Bar */
        .search-box {
            width: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            border: 2px solid #ffffff;
            color: #fff;
            padding: 12px 25px;
            border-radius: 25px;
            outline: none;
            font-size: 16px;
            text-align: center;
            margin-bottom: 15px;
        }

        /* Dropdown Filter Selector */
        .filter-select {
            background-color: rgba(0, 0, 0, 0.6);
            border: 2px solid #ffffff;
            color: #fff;
            padding: 8px 30px;
            border-radius: 20px;
            font-size: 14px;
            outline: none;
            cursor: pointer;
            text-align-last: center;
            margin-bottom: 20px;
        }

        .sub-links {
            font-size: 14px;
            color: #a3aabf;
        }
        .sub-links a {
            color: #ffffff;
            text-decoration: underline;
            margin: 0 5px;
        }

        /* Wide Game Grid System */
        .games-grid {
            width: 100%;
            max-width: 1200px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        /* Custom Cards matching the image overlays */
        .game-card {
            position: relative;
            height: 110px;
            border-radius: 12px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s ease;
            background-size: cover;
            background-position: center;
            background-color: #15171e;
        }

        .game-card:hover {
            transform: scale(1.03);
            border-color: #00ffcc;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.4);
        }

        /* Dark tint layer so text stays perfectly readable */
        .card-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.55);
            z-index: 1;
        }

        .game-card span {
            position: relative;
            z-index: 2;
            color: #ffffff;
            font-size: 22px;
            font-weight: bold;
            letter-spacing: -0.5px;
            text-align: center;
            padding: 0 10px;
        }

        /* Top Corner Favorite Star Indicator */
        .star-icon {
            position: absolute;
            top: 8px;
            right: 12px;
            color: rgba(255, 255, 255, 0.4);
            font-size: 14px;
            z-index: 2;
        }
        .game-card:hover .star-icon {
            color: #00ffcc;
        }
    </style>
</head>
