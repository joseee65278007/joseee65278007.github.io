                <span>🌌 Run 3</span> <span class="arrow-icon">↗</span>
            </a>
            <a class="game-card" target="_blank" href="https://snokido.com" data-tags="subway surfers train dash run">
                <span>🚇 Subway Surfers</span> <span class="arrow-icon">↗</span>
            </a>
