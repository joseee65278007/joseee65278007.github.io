    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: #08090c;
            color: #ffffff;
            min-height: 100vh;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            max-width: 600px;
        }

        .logo {
            font-size: 32px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #00ffcc;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #6e7994;
            font-size: 15px;
        }

        /* Search Box Filter layout */
        .search-container {
            width: 100%;
            max-width: 500px;
            margin-bottom: 40px;
        }

        .search-box {
            width: 100%;
            background-color: #11131a;
            border: 1px solid #1f2330;
            color: #fff;
            padding: 14px 20px;
            border-radius: 30px;
            outline: none;
            font-size: 16px;
            text-align: center;
            transition: border-color 0.2s;
        }
        .search-box:focus { border-color: #00ffcc; }

        /* Game Categories Grid system */
        .catalog-section {
            width: 100%;
            max-width: 1000px;
            margin-bottom: 30px;
        }

        .category-title {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #525b73;
            margin-bottom: 15px;
            font-weight: 700;
            border-bottom: 1px solid #1f2330;
            padding-bottom: 5px;
        }

        .grid-layout {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 15px;
        }

        /* Launch Links built as external target tab hooks */
        .game-card {
            background-color: #11131a;
            border: 1px solid #1f2330;
            padding: 20px;
            border-radius: 12px;
            text-decoration: none;
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .game-card:hover {
            border-color: #00ffcc;
            background-color: #161922;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 255, 204, 0.1);
        }

        .arrow-icon {
            color: #00ffcc;
            font-size: 18px;
        }
    </style>
</head>
